// Copy to secrets.h (gitignored). These are *seed defaults only*: on first
// boot they are written into NVS, and from then on NVS is the runtime truth
// (editable over the serial CLI without reflashing). Re-flashing never
// clobbers a value already in NVS.
#pragma once

// Stage 4 (WiFi + upload) — unused until then:
#define WIFI_SSID     "…"
#define WIFI_PASS     "…"
#define ENDPOINT_URL  "http://espressolog.lan:8080"

// Optional: pre-bind scales to roles by MAC (lowercase). Leave undefined to
// auto-bind the first Bookoo discovered as the yield scale.
// #define SCALE_YIELD_MAC "aa:bb:cc:dd:ee:ff"
// #define SCALE_DOSE_MAC  "aa:bb:cc:dd:ee:00"
