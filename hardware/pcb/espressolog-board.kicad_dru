(version 1)

# KiCad 10: `A.NetClass == 'Machine'` matches nothing (every rule here was
# inert until that was found on 2026-11-24); hasNetclass() is the form that
# works. There is no `Parent.Reference` either, so parts are listed with
# memberOfFootprint(). A condition KiCad cannot parse disables the WHOLE
# file and DRC silently falls back to the netclasses: after editing this,
# check that a DRC report names these rules.

# Machine nets (netclass Machine: pos 1, every raw line incl. the J3 NTC,
# J4 + and J5 Disp-P4 pass-throughs, the drive chains) keep 2 mm from
# everything of ours. Later rules override earlier ones.

(rule "machine nets among themselves"
  (condition "A.hasNetclass('Machine') && B.hasNetclass('Machine')")
  (constraint clearance (min 1.0mm)))

(rule "machine nets to everything else"
  (condition "A.hasNetclass('Machine') && !B.hasNetclass('Machine')")
  (constraint clearance (min 2.0mm)))

# A connector's or jumper's own pin pitch is not a layout choice: the XH
# headers (IN J2-J5, OUT J22-J25) are 2.5 mm, JP1/JP2 2.54 mm, so a track
# leaving one pin passes its neighbour at ~1.45 mm. That is the machine's
# own connector, as in its harness. Only tracks leaving the connector's own
# pins get this -- anything else near a connector pin still needs 2 mm.
(rule "machine fan track beside its connector's other pins"
  (condition "A.Type == 'Track' && A.hasNetclass('Machine') && B.Type == 'Pad' && (B.memberOfFootprint('J2') || B.memberOfFootprint('J3') || B.memberOfFootprint('J4') || B.memberOfFootprint('J5') || B.memberOfFootprint('J22') || B.memberOfFootprint('J23') || B.memberOfFootprint('J24') || B.memberOfFootprint('J25') || B.memberOfFootprint('JP1') || B.memberOfFootprint('JP2'))")
  (constraint clearance (min 1.2mm)))

# The machine's own ground conductors (J5 VSS, J4 T) pass straight through
# IN -> OUT between the machine pins beside them, as in the harness.
(rule "ground pass-through beside its connector's machine pins"
  (condition "A.Type == 'Pad' && A.hasNetclass('Machine') && B.Type == 'Track' && B.NetName == 'GND' && (A.memberOfFootprint('J2') || A.memberOfFootprint('J3') || A.memberOfFootprint('J4') || A.memberOfFootprint('J5') || A.memberOfFootprint('J22') || A.memberOfFootprint('J23') || A.memberOfFootprint('J24') || A.memberOfFootprint('J25') || A.memberOfFootprint('JP1') || A.memberOfFootprint('JP2'))")
  (constraint clearance (min 1.2mm)))

# Pads of one part: a connector's or jumper's own pins, an AQY's outputs.
(rule "pads of the same part"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && ((A.memberOfFootprint('J2') && B.memberOfFootprint('J2')) || (A.memberOfFootprint('J3') && B.memberOfFootprint('J3')) || (A.memberOfFootprint('J4') && B.memberOfFootprint('J4')) || (A.memberOfFootprint('J5') && B.memberOfFootprint('J5')) || (A.memberOfFootprint('J22') && B.memberOfFootprint('J22')) || (A.memberOfFootprint('J23') && B.memberOfFootprint('J23')) || (A.memberOfFootprint('J24') && B.memberOfFootprint('J24')) || (A.memberOfFootprint('J25') && B.memberOfFootprint('J25')) || (A.memberOfFootprint('JP1') && B.memberOfFootprint('JP1')) || (A.memberOfFootprint('JP2') && B.memberOfFootprint('JP2')) || (A.memberOfFootprint('U4') && B.memberOfFootprint('U4')) || (A.memberOfFootprint('U5') && B.memberOfFootprint('U5')) || (A.memberOfFootprint('U6') && B.memberOfFootprint('U6')) || (A.memberOfFootprint('U7') && B.memberOfFootprint('U7')))")
  (constraint clearance (min 0.2mm)))

# Pads with no net (the empty half of each uncut DIP-8) carry nothing: a
# machine track may pass them at the ordinary clearance.
(rule "machine nets beside pads with no net"
  (condition "A.hasNetclass('Machine') && B.Type == 'Pad' && B.NetName == ''")
  (constraint clearance (min 0.6mm)))
