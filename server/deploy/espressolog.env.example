# /etc/espressolog/env on the server box -- root:root, mode 600.
# Read by systemd (EnvironmentFile in espressolog.service); never commit
# the real file. URL, token and _TEMP are required for room readings;
# _RH is optional.

# Home Assistant base URL, reachable from the server box.
ESPRESSOLOG_HA_URL=https://homeassistant.example

# Long-lived access token: Home Assistant -> your profile -> Security.
ESPRESSOLOG_HA_TOKEN=

# Room sensor entity ids (temperature in degrees C, humidity in %).
ESPRESSOLOG_HA_TEMP=sensor.room_temperature
ESPRESSOLOG_HA_RH=sensor.room_humidity
